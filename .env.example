# --- Pflicht -----------------------------------------------------------------

# Anthropic-Schlüssel für den Chat. Ohne ihn startet das Backend, aber jede
# Chat-Anfrage scheitert.
ANTHROPIC_API_KEY=sk-ant-...

# Anmelde-Token für Geräte-Agenten. Ein Agent braucht es genau einmal, um sich
# anzumelden; danach hat er ein eigenes Token, das nur für ihn gilt und einzeln
# gesperrt werden kann. Frei wählbar: openssl rand -hex 32
AGENT_TOKEN=

# Aufbewahrungsfrist des Audit-Logs in Tagen. 0 oder leer = unbegrenzt.
# Produktiv ist eine Frist Pflicht: das Log enthält Personenbezug. Die Löschung
# wird im Log selbst vermerkt, damit die Lücke nicht wie Manipulation aussieht.
AUDIT_RETENTION_DAYS=

# --- Anmeldung (Entra ID) ----------------------------------------------------
# Aus: Entwicklungs-Benutzer, jeder gilt als DEV_ROLE. Nur für zu Hause.
# An: JWT-Prüfung gegen die Entra-JWKS. Dann sind TENANT/CLIENT/SCOPE Pflicht,
#     sonst antworten alle Portal-Routen bewusst mit 500 statt zurückzufallen.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=

# Rollen ohne Entra-App-Rollen: kommagetrennte UPNs als Notnagel.
ENTRA_IT_USERS=
ENTRA_ADMIN_USERS=
# Rolle des Entwicklungs-Benutzers, wenn ENTRA_ENABLED=false: user | it | admin
DEV_ROLE=admin

# --- Atlassian ---------------------------------------------------------------
# Bequemer über die Administrationsseite zu setzen; die .env ist der Weg für
# automatisierte Installationen. Gespeicherte Werte haben Vorrang.
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Aufgabe
CONFLUENCE_SPACE_KEYS=

# --- baramundi bConnect ------------------------------------------------------
# Nur hier konfigurierbar, nicht in der Oberfläche.
BCONNECT_SERVER=
BCONNECT_PORT=443

# v2.0 oder v1.0. v2.0 ist die Vorgabe des Treibers und der richtige Weg ab
# bMC 26.1: eigene Pfade, und Anmeldung per Schlüssel statt per Dienstkonto.
BCONNECT_VERSION=v2.0

# Nur v2, und der bessere Weg: wird BCONNECT_USER/PASSWORD vorgezogen und
# lässt sich zurückziehen, ohne ein Konto anzufassen.
BCONNECT_API_KEY=

# HTTP Basic. Für v1 der einzige Weg, für v2 der Rückfallweg.
BCONNECT_USER=
BCONNECT_PASSWORD=

# Nur für Testinstallationen mit selbst ausgestelltem Zertifikat.
BCONNECT_ALLOW_SELF_SIGNED=false

# Abstand zwischen zwei Statusabfragen eines laufenden Jobs, in Millisekunden.
BCONNECT_POLL_MS=5000

# PFLICHT, sonst ist kein einziger Job ausführbar. Kommagetrennte Job-IDs —
# der bMS-Katalog enthält auch Rollouts, die nicht in einen Chat gehören.
BCONNECT_ALLOWED_JOBS=

# Jobs, die das Portal im Kiosk freigeben darf. Zweite, unabhaengige Liste:
# BCONNECT_ALLOWED_JOBS erlaubt dem Chat, etwas auf einem Geraet auszufuehren,
# diese hier erlaubt einem Mitarbeiter, sich selbst etwas zu installieren.
# Kommagetrennte Job-NAMEN wie im bMS-Katalog. Leer heisst: Kiosk-Bereich aus.
BCONNECT_KIOSK_JOBS=

# Adresse der Kiosk-Weboberflaeche. Ohne Angabe wird sie aus BCONNECT_SERVER
# gebildet: https://{server}/bWebServer/Kiosk (Vorgabe des Herstellers).
BCONNECT_KIOSK_URL=

# --- Lokale Konten (Anmeldeweg 'local') --------------------------------------
# Konto und Passwort aus der portaleigenen Datenbank. Das Passwort wird wirklich
# geprueft (scrypt) — geprueft wird aber gegen das Portal, nicht gegen das
# Unternehmensverzeichnis. Fuer den Echtbetrieb bleibt Entra der richtige Weg.
#
# Rangfolge der Anmeldewege: ENTRA_ENABLED schlaegt LOCAL_LOGIN, LOCAL_LOGIN
# schlaegt SIMPLE_LOGIN. Zwei Wege gleichzeitig gibt es nicht.
LOCAL_LOGIN=false

# Geheimnis fuer die Sitzungstoken. Ohne Angabe wird je Start eines erzeugt —
# dann sind nach jedem Neustart alle abgemeldet. openssl rand -hex 32
LOCAL_LOGIN_SECRET=
LOCAL_SESSION_HOURS=12

# Die Startkonten. Sie werden NUR angelegt, wenn die Tabelle leer ist; ein
# geloeschtes Konto kommt dadurch nicht zurueck. Beide gelten als „muss
# geaendert werden", und die Oberflaeche sagt das auch.
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=admin
LOCAL_USER_USER=user
LOCAL_USER_PASSWORD=1234

# --- Datenbank (Postgres) ----------------------------------------------------
# Traegt die Konten und die Kiosk-Anforderungen. PFLICHT, sobald LOCAL_LOGIN=true
# ist; ohne sie antwortet die Anmeldung mit 503 statt jemanden durchzulassen.
#
# DB_PASSWORD ist auch fuer docker-compose Pflicht: der Postgres-Container
# bekommt es als POSTGRES_PASSWORD. openssl rand -hex 24
DB_PASSWORD=
# Vorgaben: Host "db" (der Container im selben Netz), Datenbank bfs_portal,
# Benutzer portal. Nur aendern, wenn ein eigener Server benutzt wird.
DB_HOST=db
DB_PORT=5432
DB_NAME=bfs_portal
DB_USER=portal
# Alternativ zu den fuenf Werten oben ein vollstaendiger Verbindungsstring.
# Er hat Vorrang.
DATABASE_URL=
