# --- Pflicht -----------------------------------------------------------------

# Anthropic-Schlüssel für den Chat. Ohne ihn startet das Backend, aber jede
# Chat-Anfrage scheitert.
ANTHROPIC_API_KEY=sk-ant-...

# Gemeinsames Geheimnis zwischen Backend und Geräte-Agent. Frei wählbar,
# lang und zufällig: openssl rand -hex 32
AGENT_TOKEN=

# --- Anmeldung (Entra ID) ----------------------------------------------------
# Aus: Entwicklungs-Benutzer, jeder gilt als DEV_ROLE. Nur für zu Hause.
# An: JWT-Prüfung gegen die Entra-JWKS. Dann sind TENANT/CLIENT/SCOPE Pflicht,
#     sonst antworten alle Portal-Routen bewusst mit 500 statt zurückzufallen.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=

# Rollen ohne Entra-App-Rollen: kommagetrennte UPNs als Notnagel.
ENTRA_IT_USERS=
ENTRA_ADMIN_USERS=
# Rolle des Entwicklungs-Benutzers, wenn ENTRA_ENABLED=false: user | it | admin
DEV_ROLE=admin

# --- Atlassian ---------------------------------------------------------------
# Bequemer über die Administrationsseite zu setzen; die .env ist der Weg für
# automatisierte Installationen. Gespeicherte Werte haben Vorrang.
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Aufgabe
CONFLUENCE_SPACE_KEYS=

# --- Microsoft Graph (SSPR-Triage) ------------------------------------------
ENTRA_GRAPH_CLIENT_ID=
ENTRA_GRAPH_CLIENT_SECRET=

# --- baramundi bConnect ------------------------------------------------------
BCONNECT_SERVER=
BCONNECT_PORT=443
BCONNECT_VERSION=v1.0
BCONNECT_USER=
BCONNECT_PASSWORD=
BCONNECT_ALLOW_SELF_SIGNED=false
# PFLICHT, sonst ist kein einziger Job ausführbar. Kommagetrennte Job-IDs —
# der bMS-Katalog enthält auch Rollouts, die nicht in einen Chat gehören.
BCONNECT_ALLOWED_JOBS=
